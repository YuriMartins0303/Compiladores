Terminals unused in grammar

    ERROR


Grammar

    0 $accept: program $end

    1 program: class_list

    2 class_list: class
    3           | class_list class
    4           | error ';'

    5 class: CLASS TYPEID '{' feature_list '}' ';'
    6      | CLASS TYPEID INHERITS TYPEID '{' feature_list '}' ';'

    7 feature_list: ε
    8             | feature_list feature ';'
    9             | feature_list error ';'

   10 feature: OBJECTID ':' TYPEID
   11        | OBJECTID ':' TYPEID ASSIGN expression
   12        | OBJECTID '(' formal_list ')' ':' TYPEID '{' expression '}'
   13        | OBJECTID '(' ')' ':' TYPEID '{' expression '}'

   14 formal_list: formal
   15            | formal_list ',' formal

   16 formal: OBJECTID ':' TYPEID

   17 case_list: case
   18          | case_list case

   19 case: OBJECTID ':' TYPEID DARROW expression ';'

   20 auxiliar_let: OBJECTID ':' TYPEID IN expression
   21             | OBJECTID ':' TYPEID ASSIGN expression IN expression
   22             | OBJECTID ':' TYPEID ',' auxiliar_let
   23             | OBJECTID ':' TYPEID ASSIGN expression ',' auxiliar_let
   24             | error ',' auxiliar_let

   25 expressions_block: expression ';'
   26                  | expressions_block expression ';'
   27                  | error ';'
   28                  | expressions_block error ';'

   29 expressions_arg: expression
   30                | expressions_arg ',' expression

   31 expression: INT_CONST
   32           | BOOL_CONST
   33           | STR_CONST
   34           | OBJECTID
   35           | '~' expression
   36           | NOT expression
   37           | ISVOID expression
   38           | NEW TYPEID
   39           | expression '+' expression
   40           | expression '-' expression
   41           | expression '*' expression
   42           | expression '/' expression
   43           | expression '=' expression
   44           | expression '<' expression
   45           | expression LE expression
   46           | '(' expression ')'
   47           | '{' expressions_block '}'
   48           | OBJECTID ASSIGN expression
   49           | OBJECTID '(' expressions_arg ')'
   50           | OBJECTID '(' ')'
   51           | expression '.' OBJECTID '(' expressions_arg ')'
   52           | expression '.' OBJECTID '(' ')'
   53           | expression '@' TYPEID '.' OBJECTID '(' expressions_arg ')'
   54           | expression '@' TYPEID '.' OBJECTID '(' ')'
   55           | IF expression THEN expression ELSE expression FI
   56           | WHILE expression LOOP expression POOL
   57           | CASE expression OF case_list ESAC
   58           | LET auxiliar_let


